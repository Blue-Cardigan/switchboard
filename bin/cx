#!/bin/zsh
#? cx — run inside Claude Code, as !cx. Hands this conversation to Codex
#?      and closes Claude Code, so the same terminal comes back as Codex.
#?
#?      cx --alongside  open Codex beside this session instead of replacing it
#?                      (tmux split, or a new tab/window) and leave Claude running
#?      cx --print      show the command instead of switching
#?      cx --preview    show what would be imported, without switching
#?      cx --no-quit    stage it but leave Claude Code running
#?
#?      cx --desktop      list conversations from Claude desktop's local agent mode
#?      cx --desktop 2    hand desktop conversation 2 to Codex, opened alongside
#?                        (--print to just show the command, --cwd DIR to resume elsewhere)
#?      cx UUID         hand a closed Claude Code session to Codex by id
#?                      (--print to show its resume command)
#?
#?      cx --context      print this conversation as text, to paste into Codex yourself
#?      cx --queue        push it into the Codex session already running here
#?      cx --queue <id>   push it into a named Codex session
#?                        (both leave Claude Code running and start no new thread)
#?
#?      Typed at a shell prompt (no !) after Claude has closed, cx finishes a handoff
#?      that is still waiting for this terminal.
SELF="${0:A}"
ROOT="${SELF:h}/.."
case "$1" in -h|--help) grep '^#?' "$SELF" | sed 's/^#?\ \{0,1\}//'; exit 0 ;; esac
SB_ROOT="$ROOT"
source "$ROOT/scripts/finish.zsh"
NAMED=0
for a in "$@"; do
  [[ "$a" =~ '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' ]] && NAMED=1
done
# Typed at a shell prompt with a handoff already waiting here? Finish that one
# rather than trying to start a new one. This is what makes cc/cx work in a
# terminal whose shell never sourced the wrapper. --desktop is always a fresh
# import, so it never claims a staged handoff.
if [[ $NAMED -eq 0 && " $* " != *" --desktop "* && " $* " != *" --session "* && " $* " != *" --preview "* && " $* " != *" --context "* && " $* " != *" --queue "* && "$(node "$ROOT/scripts/context.mjs")" != claude && -n "$(_switchboard_staged)" ]]; then
  _switchboard_finish
  exit $?
fi
args=()
# --alongside adds a session rather than taking this one over, so nothing closes.
if [[ $NAMED -eq 0 && " $* " != *" --no-quit "* && " $* " != *" --alongside "* && " $* " != *" --desktop "* && " $* " != *" --session "* && " $* " != *" --preview "* && " $* " != *" --context "* && " $* " != *" --queue "* ]]; then
  args+=(--quit)
fi
for a in "$@"; do [[ "$a" == "--no-quit" ]] || args+=("$a"); done
exec node "$ROOT/scripts/tocodex.mjs" "${args[@]}"
