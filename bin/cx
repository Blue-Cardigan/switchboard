#!/bin/zsh
#? cx — run inside Claude Code, as !cx. Hands this conversation to Codex
#?      and closes Claude Code, so the same terminal comes back as Codex.
#?
#?      cx --print   show the command instead of switching
#?      cx --no-quit stage it but leave Claude Code running
#?
#?      Typed at a shell prompt (no !) after Claude has closed, cx finishes a handoff
#?      that is still waiting for this terminal.
SELF="${0:A}"
ROOT="${SELF:h}/.."
case "$1" in -h|--help) grep '^#?' "$SELF" | sed 's/^#?\ \{0,1\}//'; exit 0 ;; esac
SB_ROOT="$ROOT"
source "$ROOT/scripts/finish.zsh"
# Typed at a shell prompt with a handoff already waiting here? Finish that one
# rather than trying to start a new one. This is what makes cc/cx work in a
# terminal whose shell never sourced the wrapper.
if [[ "$(node "$ROOT/scripts/context.mjs")" != claude && -n "$(_switchboard_staged)" ]]; then
  _switchboard_finish
  exit $?
fi
args=()
[[ " $* " == *" --no-quit "* ]] || args+=(--quit)
for a in "$@"; do [[ "$a" == "--no-quit" ]] || args+=("$a"); done
exec node "$ROOT/scripts/tocodex.mjs" "${args[@]}"
