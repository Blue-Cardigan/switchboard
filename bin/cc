#!/bin/zsh
#? cc — run inside Codex, as !cc. Hands this conversation to Claude Code and closes
#?      Codex, so the same terminal comes back as Claude Code. One step.
#?      Works with no Codex credit.
#?
#?      cc --alongside  open Claude Code beside this session instead of replacing it
#?                      (tmux split, or a new tab/window) and leave Codex running
#?      cc --print      show the command instead of switching
#?      cc --no-quit    stage it but leave Codex running (exit it yourself)
#?
#?      cc --fork       inside Claude Code: duplicate THIS conversation into a
#?                      second one beside it (implied by --alongside), so both run
#?                      --model <id> gives the copy a different model
#?
#?      cc --desktop      list conversations from Claude desktop's local agent mode
#?      cc --desktop 2    resume desktop conversation 2 here, in Claude Code
#?                        (--print to just show the command, --cwd DIR to resume elsewhere)
#?
#?      Typed at a shell prompt (no !) after Codex has closed, cc finishes a handoff
#?      that is still waiting for this terminal.
SELF="${0:A}"
ROOT="${SELF:h}/.."
case "$1" in -h|--help) grep '^#?' "$SELF" | sed 's/^#?\ \{0,1\}//'; exit 0 ;; esac
SB_ROOT="$ROOT"
source "$ROOT/scripts/finish.zsh"
# Typed at a shell prompt with a handoff already waiting here? Finish that one
# rather than trying to start a new one. This is what makes cc/cx work in a
# terminal whose shell never sourced the wrapper. --desktop is always a fresh
# import, so it never claims a staged handoff.
if [[ " $* " != *" --desktop "* && "$(node "$ROOT/scripts/context.mjs")" != codex && -n "$(_switchboard_staged)" ]]; then
  _switchboard_finish
  exit $?
fi
# Claude desktop -> Claude Code CLI. The desktop app writes an ordinary Claude
# Code transcript inside its sandbox, so this is a copy and a resume, not a
# conversion — and it needs no Codex session at either end.
if [[ " $* " == *" --desktop "* ]]; then
  dargs=(desktop)
  for a in "$@"; do [[ "$a" == "--desktop" ]] || dargs+=("$a"); done
  # Run as !cc from inside Codex there is no terminal to take over — ! gives a
  # short-lived subshell — so open a pane beside it instead.
  if [[ "$(node "$ROOT/scripts/context.mjs")" == codex && " $* " != *" --print "* ]]; then
    dargs+=(--alongside)
  fi
  OUT=$(node "$ROOT/scripts/import.mjs" "${dargs[@]}") || exit $?
  if [[ "$OUT" == *$'\t'* ]]; then
    SID="${OUT%%$'\t'*}"
    DIR="${OUT#*$'\t'}"
    cd "$DIR" || exit 1
    exec claude --resume "$SID"
  fi
  print -r -- "$OUT"
  exit 0
fi

HOST="$(node "$ROOT/scripts/context.mjs")"
# Was a Codex session actually named? Anything that is not a flag selects one.
NAMED=0
for a in "$@"; do [[ "$a" == --* ]] || NAMED=1; done
if [[ " $* " == *" --here "* || " $* " == *" --last "* ]]; then NAMED=1; fi

# Inside Claude Code with nothing named, "this conversation" is the one running
# here — not the newest Codex thread in this directory. Reaching for that is how
# you end up staring at a conversation you did not ask for.
if [[ "$HOST" == claude && $NAMED -eq 0 ]]; then
  if [[ " $* " == *" --alongside "* || " $* " == *" --fork "* ]]; then
    fargs=()
    for a in "$@"; do case "$a" in --alongside|--fork) ;; *) fargs+=("$a") ;; esac; done
    exec node "$ROOT/scripts/fork.mjs" "${fargs[@]}"
  fi
  print -r -- "cc: you are already in Claude Code, and no Codex session was named.

  cc --alongside   fork this conversation into a side chat beside it
  cx               hand this conversation to Codex instead
  cc --last        bring the newest Codex session here
  cc <n>           pick one from  cx2cc list"
  exit 1
fi

if [[ " $* " == *" --fork "* ]]; then
  print -r -- "cc: --fork duplicates a Claude Code conversation, and this is Codex.
Use  cc --alongside  to open this thread in Claude Code without closing Codex."
  exit 1
fi

args=(handoff --replace)
# --alongside adds a session rather than taking this one over, so nothing closes.
if [[ " $* " != *" --no-quit "* && " $* " != *" --alongside "* && " $* " != *" --window "* ]]; then
  args+=(--quit)
fi
for a in "$@"; do [[ "$a" == "--no-quit" ]] || args+=("$a"); done
exec node "$ROOT/scripts/import.mjs" "${args[@]}"
